# ===========================================
# BW Store - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# -------------------------------------------
# Application
# -------------------------------------------
APP_NAME="BW Store"
APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_KEY=

# -------------------------------------------
# Database
# -------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bw_store
DB_USER=root
DB_PASSWORD=

# -------------------------------------------
# Session
# -------------------------------------------
SESSION_LIFETIME=120
SESSION_NAME=bw_store_session
SESSION_SECURE=false
SESSION_DOMAIN=

# -------------------------------------------
# Mail (SMTP)
# -------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="BW Store"

# -------------------------------------------
# Payment Gateway (Razorpay)
# -------------------------------------------
# Subscription payments (Merchant → BW Store)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -------------------------------------------
# Admin
# -------------------------------------------
ADMIN_EMAIL=admin@bwwebstudio.com
ADMIN_PASSWORD=
ADMIN_NAME="BW Admin"

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=15

# -------------------------------------------
# Upload
# -------------------------------------------
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,svg
